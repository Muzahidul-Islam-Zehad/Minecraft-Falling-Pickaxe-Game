# Minecraft Endless Fall — environment template (placeholders only, master spec §60)
# Copy to .env and fill in real values. .env is git-ignored and must never be committed.

# ---- Server (Phase 9+) ----
# Port for the PC server HTTP/Socket.IO listener.
SERVER_PORT=3000

# ---- Socket auth tokens (Phase 11, master spec §52) ----
# Generate random values for local use. The phone gets GAME_TOKEN only.
GAME_TOKEN=replace-with-random-game-token
ADMIN_TOKEN=replace-with-random-admin-token

# ---- YouTube Live Chat (Phase 12, master spec §57-§60) ----
# Credentials live ONLY on the PC server. Never in apps/game or any browser code.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# The live video ID whose chat the server should listen to.
YOUTUBE_VIDEO_ID=
